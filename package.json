{
  "name": "switcheroo",
  "version": "1.0.0",
  "description": "1-Click Steam Account Switcher & Dota 2 Settings Synchronizer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win nsis portable zip",
    "build:dir": "electron-builder --win dir"
  },
  "keywords": [
    "steam",
    "dota2",
    "account-switcher",
    "hotkeys-sync",
    "electron"
  ],
  "author": "Mightyiest",
  "license": "ISC",
  "homepage": "https://github.com/Mightyiest/Switcheroo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mightyiest/Switcheroo.git"
  },
  "type": "commonjs",
  "build": {
    "appId": "com.mightyiest.switcheroo",
    "productName": "Switcheroo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Switcheroo",
      "artifactName": "${productName}-Setup-v${version}.${ext}",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-v${version}.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": "Switcheroo"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
